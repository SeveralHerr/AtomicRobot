\# Godot 4+ specific ignores
.godot/
# *.import files are committed: they carry each asset's uid:// (Godot 4 docs).
# Ignoring them made every machine/CI mint new UIDs and left scenes with stale refs.
.import/
.godot/imported/

# Python bytecode from tools/ helpers
__pycache__/
*.pyc

# Autoplay bot reports and screenshots (tools/autoplay.py)
autoplay_out/

# Export output: Godot imports the icons it finds there; those .import files are noise.
/bin/*.import
